# .env.local.example
# Copie ce fichier en .env.local et remplis les valeurs

# ═══════════════════════════════════════════════════════
# BREVO (Email + Lead Capture)
# ═══════════════════════════════════════════════════════

# API Key Brevo — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_api_key_here

# ID de la liste principale pour les leads
# Default: 2 (créée automatiquement à l'inscription Brevo)
BREVO_LIST_ID=2

# Template ID pour email de confirmation
# Créer un template dans Brevo et remplacer par l'ID
BREVO_TEMPLATE_ID_CONFIRMATION=1

# ═══════════════════════════════════════════════════════
# ANALYTICS
# ═══════════════════════════════════════════════════════

# Google Analytics 4 — https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics — https://plausible.io/
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=btp-compare.fr

# ═══════════════════════════════════════════════════════
# AFFILIATE TRACKING (optionnel)
# ═══════════════════════════════════════════════════════

# Clé secrète pour tracker les conversions (webhook)
AFFILIATE_WEBHOOK_SECRET=your_secret_key

# URL du webhook d'affiliation (recevra les conversions)
AFFILIATE_WEBHOOK_URL=https://your-tracking-service.com/webhook
